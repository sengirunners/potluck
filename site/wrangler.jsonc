{
  "name": "potluck-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "account_id": "246355770c9ff4630b40496b282a7b46",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/install.sh"]
  },
  // The closed waitlist's sign-ups, read by GET /api/waitlist/count until the list is deleted (README.md).
  // CONTACT: the founders form's messages, read by GET /api/contact (README.md).
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "769e70d2a2f541068d81f0c3e3af33d4" },
    { "binding": "CONTACT", "id": "05663cbc62124bdb9df76f0bf93933e3" }
  ],
  // NOTIFY: emails each message the founders form keeps to the one address below (src/notify.js); NOTIFY_FROM is
  // the sender, on a domain Cloudflare sends mail for (README.md, "The founders form").
  "send_email": [{ "name": "NOTIFY", "destination_address": "ops@sengi.run" }],
  "vars": { "NOTIFY_FROM": "form@notify.potluck.sh" },
  "routes": [
    { "pattern": "potluck.sh", "custom_domain": true },
    { "pattern": "www.potluck.sh", "custom_domain": true }
  ]
}
