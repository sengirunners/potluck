{
  // mezze.sh: Mezze's site (site/README.md, "mezze.sh"). Deploy from site/ with `npm run deploy:mezze`.
  "name": "mezze-site",
  "main": "../src/mezze.js",
  "compatibility_date": "2026-11-01",
  "account_id": "246355770c9ff4630b40496b282a7b46",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // CONTACT and the NOTIFY_ vars are potluck.sh's: the founders form keeps every message in one place and emails the same
  // address, whichever site it was sent from (each message records its site). Secret: RESEND_API_KEY.
  "kv_namespaces": [{ "binding": "CONTACT", "id": "05663cbc62124bdb9df76f0bf93933e3" }],
  "vars": { "NOTIFY_FROM": "Founders form <form@sengi.run>", "NOTIFY_TO": "ops@sengi.run" },
  "routes": [
    { "pattern": "mezze.sh", "custom_domain": true },
    { "pattern": "www.mezze.sh", "custom_domain": true }
  ]
}
